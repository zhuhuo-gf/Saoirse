{
  "name": "saoirse-desktop",
  "version": "0.4.1",
  "description": "Saoirse — an anime-inspired desktop companion for DeepSeek Harness",
  "private": true,
  "main": "main.js",
  "author": {
    "name": "Saoirse Project Contributors"
  },
  "homepage": "https://example.invalid/saoirse-desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icons": "node make-icons.js",
    "runtime:win": "node download-node.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "app.saoirse.desktop",
    "productName": "Saoirse",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "afterPack": "afterPack.js",
    "files": [
      "**/*",
      "!node_modules/**",
      "!dsh-bundle/**",
      "!electron-dist/**",
      "!.npm-cache/**",
      "!.electron-cache/**",
      "!.electron-builder-cache/**",
      "!.dsh-home*/**",
      "!node-runtime/**",
      "!gitpush/**",
      "!probe-electron.js",
      "!download-electron.js",
      "!download-node.js",
      "!make-icons.js",
      "!afterPack.js",
      "!remove-pet-bg.js",
      "!analyze-pet.js",
      "!update-pet-frames.js",
      "!f00eacea082fad95a74d30b4206e1954.jpg",
      "!proofshot-artifacts/**",
      "!work-welcome*.png",
      "!work-*.png",
      "!work-*/**",
      "!README.md",
      "!.gitignore"
    ],
    "extraResources": [
      {
        "from": "node-runtime",
        "to": "node-runtime"
      },
      {
        "from": "dsh-bundle/node_modules",
        "to": "dsh/node_modules"
      },
      {
        "from": "bundled-skills",
        "to": "bundled-skills"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "shortcutName": "Saoirse"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
